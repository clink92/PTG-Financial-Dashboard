generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MonthData {
  monthKey   String   @id
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("month_data")
}

model ImportLogMonth {
  monthKey   String   @id
  entries    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("import_log_month")
}
