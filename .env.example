# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-change-in-production
# Optional: NextAuth can infer from the request host; if you set this, keep it in sync with your current URL/port.
NEXTAUTH_URL=http://localhost:3000

# OpenAI API Key (optional - for enhanced AI insights)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional persistent storage (recommended for Vercel deployments)

# Optional Prisma Postgres (preferred over Redis/KV when set)
# DATABASE_URL=postgres://...
# POSTGRES_URL=postgres://...
# PRISMA_DATABASE_URL=postgres://...
# Create a Vercel KV database and paste its env vars here.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Application Settings
NODE_ENV=development
